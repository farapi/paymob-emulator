{
  "name": "@paymob-simulator/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./cards": { "types": "./dist/cards.d.ts", "default": "./dist/cards.js" },
    "./states": { "types": "./dist/states.d.ts", "default": "./dist/states.js" },
    "./duration": { "types": "./dist/duration.d.ts", "default": "./dist/duration.js" },
    "./intention": { "types": "./dist/intention.d.ts", "default": "./dist/intention.js" },
    "./transaction": { "types": "./dist/transaction.d.ts", "default": "./dist/transaction.js" },
    "./hmac": { "types": "./dist/hmac.d.ts", "default": "./dist/hmac.js" },
    "./projection": { "types": "./dist/projection.d.ts", "default": "./dist/projection.js" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
